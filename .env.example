# Copy to .env and choose your own password. Never commit .env.
# Used by docker-compose.yml, by `npm run dev`, and by the E2E suite.
POSTGRES_PASSWORD=change_me
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/loancalc?schema=public"
# If another PostgreSQL already uses 5432 on this machine, pick another host port
# and use it in DATABASE_URL too:
# POSTGRES_PORT=55432

# Optional:
# DATABASE_SSL=require        # true | require | no-verify | false | disable (default: TLS for remote DBs in production)
# DATABASE_POOL_MAX=10
# RATE_LIMIT_STORE=memory      # memory | redis (default: redis when Upstash credentials are set)

# Vercel only (set in the Vercel project per environment, never committed):
# DATABASE_URL=postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require   # pooled, for the app
# DIRECT_URL=postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require            # direct, for migrations
# UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io     # or KV_REST_API_URL from the Vercel Marketplace
# UPSTASH_REDIS_REST_TOKEN=<token>                         # or KV_REST_API_TOKEN
