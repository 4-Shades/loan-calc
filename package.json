{
  "name": "loan-calc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --project component",
    "test:watch": "vitest --project unit --project component",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:perf": "vitest run --project perf",
    "test:coverage": "vitest run --project unit --project component --coverage",
    "test:e2e": "bddgen && playwright test",
    "test:compose": "bash scripts/compose-smoke.sh",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:up": "docker compose up -d --wait postgres && prisma migrate deploy",
    "db:migrate": "prisma migrate deploy",
    "verify": "npm run db:generate && npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-virtual": "^3.14.21",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "playwright-bdd": "^9.2.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "testcontainers": "^12.2.1",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
